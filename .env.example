# Copiá este archivo a ".env" y completá con la URL de tu esquema ORDS.
#
# La forma general es:
#   https://<host-de-tu-autonomous-db>/ords/<nombre-del-esquema>
#
# La encontrás en OCI: tu Autonomous Database -> "Database Actions" ->
# copiás la URL que te muestra ahí y le agregás /ords/tu_schema si no
# lo trae puesto. Terminá SIN barra al final.

VITE_ORDS_BASE_URL=https://xxxxxxxx.adb.sa-saopaulo-1.oraclecloudapps.com/ords/horas_app
